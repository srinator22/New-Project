{
  "name": "final",
  "label": "FINAL 960x540 512 SPP",
  "settings": {
    "scene.engine": "CYCLES",
    "scene.resolution": [
      960,
      540
    ],
    "scene.view_transform": "AgX",
    "scene.motion_blur": true,
    "scene.cycles.samples": 512,
    "scene.cycles.use_adaptive_sampling": true,
    "scene.cycles.adaptive_threshold": 0.01,
    "scene.cycles.use_denoising": true,
    "scene.cycles.denoiser": "OPENIMAGEDENOISE",
    "scene.cycles.denoising_input_passes": "RGB_ALBEDO_NORMAL",
    "scene.cycles.denoising_prefilter": "ACCURATE",
    "scene.cycles.seed": 0,
    "scene.cycles.use_animated_seed": false,
    "scene.cycles.filter_width": 1.75,
    "scene.cycles.sample_clamp_indirect": 10.0
  },
  "transparent_min_samples": 512,
  "allow_units": [
    "METRIC"
  ],
  "max_light_ratio": 1000,
  "film_grain": false,
  "notes": "seed policy and filter width are defaults to measure; the seed A/B in RECORD.md decides use_animated_seed"
}
